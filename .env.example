# 应用配置
APP_NAME=User Service
APP_VERSION=1.0.0
APP_ENV=development
DEBUG=True

# 服务配置
HOST=0.0.0.0
PORT=8000

# 数据库配置 (SQLite)
DATABASE_URL=sqlite+aiosqlite:///./data/user_service.db
DATABASE_ECHO=False

# Redis 配置（邮箱验证码 / Token 服务端管控存储）
REDIS_URL=redis://localhost:6379/0

# SMTP 配置（网易邮箱发件）
# SMTP_USER：发件邮箱账号；SMTP_PASSWORD：客户端授权码（需在网易邮箱开启 SMTP 服务后生成，非登录密码）
SMTP_HOST=smtp.163.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_NAME=User Service
SMTP_USE_TLS=True
SMTP_TIMEOUT=10

# 邮箱验证码配置
VERIFY_CODE_LENGTH=6
VERIFY_CODE_EXPIRE_SECONDS=300
VERIFY_CODE_COOLDOWN_SECONDS=60
VERIFY_CODE_DAILY_LIMIT=10
VERIFY_CODE_MAX_ATTEMPTS=5

# JWT 配置（RS256 非对称加密）
# JWT_PRIVATE_KEY / JWT_PUBLIC_KEY：首次启动迁移导入的旧 PEM（路径或 PEM 字符串），之后由密钥目录接管
JWT_PRIVATE_KEY=keys/jwt_private.pem
JWT_PUBLIC_KEY=keys/jwt_public.pem
ALGORITHM=RS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# JWT 密钥轮换（本地文件管理，无需数据库）
JWT_KEY_DIR=keys
JWT_ROTATION_INTERVAL_DAYS=30
JWT_RETIRE_DAYS=8
JWT_ROTATION_CHECK_HOURS=24

# 可注册业务列表（预留，专供给可选业务；user.service_name 建议在此列表内）
REGISTERED_SERVICES=["forum","shop","game"]

# 密码加密
PASSWORD_BCRYPT_ROUNDS=12

# 超级用户（部署引导：服务启动时按以下配置自动创建超级用户；SUPERUSER_PASSWORD 为空则不创建）
# 生产环境务必显式注入强密码；弱口令（过短/常见密码/与用户名相同）会被拒绝创建
SUPERUSER_USERNAME=superuser
SUPERUSER_PASSWORD=
SUPERUSER_EMAIL=superuser@local.local
SUPERUSER_FULL_NAME=Super User
SUPERUSER_SERVICE_NAME=default

# 日志配置
LOG_LEVEL=INFO
LOG_FILE=logs/user_service.log
LOG_MAX_BYTES=10485760
LOG_BACKUP_COUNT=5

# CORS 配置
ALLOWED_ORIGINS=["http://localhost:3000","http://localhost:8000"]

# 日志操作类型
LOG_OPERATIONS=["user_create","user_update","user_delete","user_login","user_logout","password_change","user_status_change","role_change"]
